NODE_ENV=development
APP_ENV=local
API_PORT=5050
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
PG_BOSS_SCHEMA=pgboss
# Runtime connection string for API (cloud Supabase session pooler)
# Format: postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (e.g. ! → %21)
DATABASE_URL=
# Direct connection (same pooler URL works; only needed separately if using transaction pooler)
DIRECT_URL=
SUPABASE_PROJECT_REF=cbcgrzvqidtrtrtnzlso
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Set manually outside git when required. Never commit a service-role key.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_KEY=
TRENGO_WEBHOOK_SECRET=
