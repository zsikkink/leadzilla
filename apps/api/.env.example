NODE_ENV=development
APP_ENV=local
API_PORT=5050
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
PG_BOSS_SCHEMA=pgboss
# Runtime connection string for API.
# Local dev can use the direct Supabase host:
# postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Railway runtime can use the pooled host:
# postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=3
# URL-encode special characters in the password (e.g. ! → %21)
DATABASE_URL=
# Direct Prisma/CLI connection.
# Preferred: postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=
SUPABASE_PROJECT_REF=cbcgrzvqidtrtrtnzlso
SUPABASE_JWT_ISSUER=https://cbcgrzvqidtrtrtnzlso.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Optional Supabase CLI / ops helpers. Not required for API runtime boot.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Set manually outside git when required. Never commit a service-role key.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_KEY=
TRENGO_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=
