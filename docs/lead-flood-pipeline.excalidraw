{"type":"excalidraw","version":2,"source":"https://excalidraw.com","elements":[{"angle":0,"seed":100,"version":1,"versionNonce":101,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"text","id":"tt","x":170,"y":0,"width":480,"height":43.2,"text":"Lead-Flood Sales Pipeline","fontSize":32,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":32,"containerId":null,"originalText":"Lead-Flood Sales Pipeline","lineHeight":1.35},{"angle":0,"seed":102,"version":1,"versionNonce":103,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"text","id":"ts","x":100,"y":44,"width":529.1999999999999,"height":24.3,"text":"Complete Workflow — From Discovery to Closed Deal","fontSize":18,"fontFamily":1,"strokeColor":"#757575","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":18,"containerId":null,"originalText":"Complete Workflow — From Discovery to Closed Deal","lineHeight":1.35},{"angle":0,"seed":104,"version":1,"versionNonce":105,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"rectangle","id":"z1bg","x":40,"y":80,"width":1130,"height":720,"backgroundColor":"#dbe4ff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#4a9eed","strokeWidth":1,"roughness":1,"opacity":25},{"angle":0,"seed":106,"version":1,"versionNonce":107,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"text","id":"z1t","x":55,"y":88,"width":172.79999999999998,"height":32.400000000000006,"text":"1. DISCOVERY","fontSize":24,"fontFamily":1,"strokeColor":"#2563eb","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":24,"containerId":null,"originalText":"1. DISCOVERY","lineHeight":1.35},{"angle":0,"seed":108,"version":1,"versionNonce":109,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"text","id":"z1s","x":55,"y":118,"width":508.79999999999995,"height":21.6,"text":"Find businesses that match our ideal customer profile","fontSize":16,"fontFamily":1,"strokeColor":"#4a9eed","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"Find businesses that match our ideal customer profile","lineHeight":1.35},{"angle":0,"seed":110,"version":1,"versionNonce":111,"groupIds":[],"boundElements":[{"type":"text","id":"b1_label"}],"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"rectangle","id":"b1","x":100,"y":160,"width":250,"height":55,"backgroundColor":"#a5d8ff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#4a9eed","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":112,"version":1,"versionNonce":113,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"text","id":"b1_label","x":100,"y":160,"width":250,"height":55,"text":"Seed Search Tasks","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b1","originalText":"Seed Search Tasks","lineHeight":1.35},{"angle":0,"seed":114,"version":1,"versionNonce":115,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286539,"link":null,"locked":false,"type":"rectangle","id":"dp1","x":420,"y":152,"width":710,"height":100,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#a5d8ff","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":116,"version":1,"versionNonce":117,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt1","x":435,"y":160,"width":691.1999999999999,"height":129.60000000000002,"text":"HOW SEEDING WORKS\n\nYour ICP profile defines target industries and countries. We combine\nthem into queries like 'luxury fashion in Dubai' or 'fintech Abu Dhabi'.\nIf you request 100 leads and our yield rate is 20%, we auto-generate\n~750 search tasks (100 / 0.20 x 1.5 safety margin) to hit your target.","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"HOW SEEDING WORKS\n\nYour ICP profile defines target industries and countries. We combine\nthem into queries like 'luxury fashion in Dubai' or 'fintech Abu Dhabi'.\nIf you request 100 leads and our yield rate is 20%, we auto-generate\n~750 search tasks (100 / 0.20 x 1.5 safety margin) to hit your target.","lineHeight":1.35},{"angle":0,"seed":118,"version":1,"versionNonce":119,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a1","x":225,"y":215,"width":0,"height":50,"points":[[0,0],[0,50]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":120,"version":1,"versionNonce":121,"groupIds":[],"boundElements":[{"type":"text","id":"b2_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b2","x":100,"y":265,"width":250,"height":55,"backgroundColor":"#a5d8ff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#4a9eed","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":122,"version":1,"versionNonce":123,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b2_label","x":100,"y":265,"width":250,"height":55,"text":"Search the Web","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b2","originalText":"Search the Web","lineHeight":1.35},{"angle":0,"seed":124,"version":1,"versionNonce":125,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp2","x":420,"y":260,"width":710,"height":140,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#a5d8ff","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":126,"version":1,"versionNonce":127,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt2","x":435,"y":268,"width":614.4,"height":259.20000000000005,"text":"SEARCH PROVIDERS & METHODS\n\nPrimary: SerpAPI   |   Fallback: Google Places\n\nThree discovery methods per query:\n  Google organic — company websites and directories\n  Google Maps — local business listings with reviews\n  Local pins — geographic map-based discovery\n\nUp to 5 result pages per query. Each result becomes a business\nrecord: name, domain, category, phone, address, reviews, rating.\nDeduplicated by website domain across all searches.","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"SEARCH PROVIDERS & METHODS\n\nPrimary: SerpAPI   |   Fallback: Google Places\n\nThree discovery methods per query:\n  Google organic — company websites and directories\n  Google Maps — local business listings with reviews\n  Local pins — geographic map-based discovery\n\nUp to 5 result pages per query. Each result becomes a business\nrecord: name, domain, category, phone, address, reviews, rating.\nDeduplicated by website domain across all searches.","lineHeight":1.35},{"angle":0,"seed":128,"version":1,"versionNonce":129,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a2","x":225,"y":320,"width":0,"height":90,"points":[[0,0],[0,90]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":130,"version":1,"versionNonce":131,"groupIds":[],"boundElements":[{"type":"text","id":"b3_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b3","x":100,"y":410,"width":250,"height":55,"backgroundColor":"#a5d8ff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#4a9eed","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":132,"version":1,"versionNonce":133,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b3_label","x":100,"y":410,"width":250,"height":55,"text":"Scrape Website","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b3","originalText":"Scrape Website","lineHeight":1.35},{"angle":0,"seed":134,"version":1,"versionNonce":135,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp3","x":420,"y":405,"width":710,"height":215,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#a5d8ff","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":136,"version":1,"versionNonce":137,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt3","x":435,"y":412,"width":624,"height":280.8,"text":"CRAWLS 5 PAGES:  /   /about   /contact   /team   /pricing\n\nDecision Makers — name, title, seniority (CEO/VP/Manager),\n  email, phone, LinkedIn URL (up to 5 per business)\nContact Info — emails filtered (removes generic like info@,\n  support@, sales@), phones classified (WhatsApp/mobile/landline)\nSocial Links — 7 platforms: Instagram, LinkedIn, Facebook,\n  Twitter/X, TikTok, YouTube, WhatsApp\nTech Stack — CRM (Salesforce, HubSpot), live chat (Intercom,\n  Zendesk), analytics (GA, Hotjar), payments (Stripe, Tabby)\nBusiness Signals — employee count, certifications (ISO, SOC2,\n  GDPR, PCI DSS), testimonials, case studies, client logos\nPlatform — Shopify, WooCommerce, Wix, Squarespace, Webflow","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"CRAWLS 5 PAGES:  /   /about   /contact   /team   /pricing\n\nDecision Makers — name, title, seniority (CEO/VP/Manager),\n  email, phone, LinkedIn URL (up to 5 per business)\nContact Info — emails filtered (removes generic like info@,\n  support@, sales@), phones classified (WhatsApp/mobile/landline)\nSocial Links — 7 platforms: Instagram, LinkedIn, Facebook,\n  Twitter/X, TikTok, YouTube, WhatsApp\nTech Stack — CRM (Salesforce, HubSpot), live chat (Intercom,\n  Zendesk), analytics (GA, Hotjar), payments (Stripe, Tabby)\nBusiness Signals — employee count, certifications (ISO, SOC2,\n  GDPR, PCI DSS), testimonials, case studies, client logos\nPlatform — Shopify, WooCommerce, Wix, Squarespace, Webflow","lineHeight":1.35},{"angle":0,"seed":138,"version":1,"versionNonce":139,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a3","x":225,"y":465,"width":0,"height":165,"points":[[0,0],[0,165]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":140,"version":1,"versionNonce":141,"groupIds":[],"boundElements":[{"type":"text","id":"b4_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b4","x":100,"y":630,"width":250,"height":55,"backgroundColor":"#a5d8ff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#4a9eed","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":142,"version":1,"versionNonce":143,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b4_label","x":100,"y":630,"width":250,"height":55,"text":"Scrape Instagram","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b4","originalText":"Scrape Instagram","lineHeight":1.35},{"angle":0,"seed":144,"version":1,"versionNonce":145,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp4","x":420,"y":625,"width":710,"height":165,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#a5d8ff","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":146,"version":1,"versionNonce":147,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt4","x":435,"y":633,"width":633.6,"height":259.20000000000005,"text":"AUTH PRIORITY: Browser cookies > Username/password > Public scrape\n\nFollower and following count\nEngagement rate — (likes + comments) / followers per post\nBusiness category — e.g. 'Fashion Boutique', 'Restaurant'\nVerified badge and professional account status\nLast post date and total media count\nBusiness email and phone (authenticated sessions only)\nBio link presence (signals CTA and marketing awareness)\nRecent 12 posts analyzed for themes and engagement\n\nRate limited: 10 requests/minute   |   Results cached 7 days","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"AUTH PRIORITY: Browser cookies > Username/password > Public scrape\n\nFollower and following count\nEngagement rate — (likes + comments) / followers per post\nBusiness category — e.g. 'Fashion Boutique', 'Restaurant'\nVerified badge and professional account status\nLast post date and total media count\nBusiness email and phone (authenticated sessions only)\nBio link presence (signals CTA and marketing awareness)\nRecent 12 posts analyzed for themes and engagement\n\nRate limited: 10 requests/minute   |   Results cached 7 days","lineHeight":1.35},{"angle":0,"seed":148,"version":1,"versionNonce":149,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"c12","x":225,"y":685,"width":0,"height":70,"points":[[0,0],[0,70]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#757575","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":150,"version":1,"versionNonce":151,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"z2bg","x":40,"y":830,"width":1130,"height":620,"backgroundColor":"#fff3bf","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#f59e0b","strokeWidth":1,"roughness":1,"opacity":25},{"angle":0,"seed":152,"version":1,"versionNonce":153,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"z2t","x":55,"y":838,"width":230.39999999999998,"height":32.400000000000006,"text":"2. QUALIFICATION","fontSize":24,"fontFamily":1,"strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":24,"containerId":null,"originalText":"2. QUALIFICATION","lineHeight":1.35},{"angle":0,"seed":154,"version":1,"versionNonce":155,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"z2s","x":55,"y":868,"width":556.8,"height":21.6,"text":"Verify the business is real, reachable, and worth pursuing","fontSize":16,"fontFamily":1,"strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"Verify the business is real, reachable, and worth pursuing","lineHeight":1.35},{"angle":0,"seed":156,"version":1,"versionNonce":157,"groupIds":[],"boundElements":[{"type":"text","id":"b5_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b5","x":100,"y":910,"width":250,"height":55,"backgroundColor":"#ffd8a8","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#f59e0b","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":158,"version":1,"versionNonce":159,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b5_label","x":100,"y":910,"width":250,"height":55,"text":"Pre-qualify Business","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b5","originalText":"Pre-qualify Business","lineHeight":1.35},{"angle":0,"seed":160,"version":1,"versionNonce":161,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp5","x":420,"y":900,"width":710,"height":185,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#ffd8a8","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":162,"version":1,"versionNonce":163,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt5","x":435,"y":908,"width":566.4,"height":259.20000000000005,"text":"5 CHECKS — ALL MUST PASS\n\n1. Has a real website — must have a registered domain\n2. At least 15 Google reviews — minimum social proof\n3. DNS resolves — domain points to a live server (not dead)\n4. Not a parked domain — checks for registrar redirects\n   (GoDaddy, Sedo, HugeDomains) and parking keywords\n   like 'domain for sale' or 'buy this domain'\n5. Industry matches ICP — business category must overlap\n   with your target industries (fuzzy token matching)\n\nAny single check fails = business rejected immediately","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"5 CHECKS — ALL MUST PASS\n\n1. Has a real website — must have a registered domain\n2. At least 15 Google reviews — minimum social proof\n3. DNS resolves — domain points to a live server (not dead)\n4. Not a parked domain — checks for registrar redirects\n   (GoDaddy, Sedo, HugeDomains) and parking keywords\n   like 'domain for sale' or 'buy this domain'\n5. Industry matches ICP — business category must overlap\n   with your target industries (fuzzy token matching)\n\nAny single check fails = business rejected immediately","lineHeight":1.35},{"angle":0,"seed":164,"version":1,"versionNonce":165,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a4","x":225,"y":965,"width":0,"height":130,"points":[[0,0],[0,130]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":166,"version":1,"versionNonce":167,"groupIds":[],"boundElements":[{"type":"text","id":"b6_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b6","x":100,"y":1095,"width":250,"height":55,"backgroundColor":"#ffd8a8","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#f59e0b","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":168,"version":1,"versionNonce":169,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b6_label","x":100,"y":1095,"width":250,"height":55,"text":"Convert to Lead","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b6","originalText":"Convert to Lead","lineHeight":1.35},{"angle":0,"seed":170,"version":1,"versionNonce":171,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp6","x":420,"y":1090,"width":710,"height":280,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#ffd8a8","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":172,"version":1,"versionNonce":173,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt6","x":435,"y":1098,"width":585.6,"height":410.40000000000003,"text":"FIND THE BEST CONTACT — CHEAPEST SOURCES FIRST\n\nStep 1: Website scrape data (FREE)\n  Extract decision makers and their emails from crawled pages\nStep 2: Instagram profile (FREE)\n  Pull business email and phone from authenticated profile\nStep 3: Apollo pre-screen (FREE)\n  Check if Apollo has contact data — no credits charged\nStep 4: SMTP-verify every email found so far\n  MX lookup + mailbox probe + catch-all detection\n  Blocks ~500 known disposable email domains\n  Filters out generic addresses (info@, support@, sales@)\nStep 5: If still no valid email -> Hunter ($1 per lookup)\n  Domain search, discards results with confidence < 70%\nStep 6: If Hunter also fails -> Apollo ($1 per lookup)\n  Premium contact data used only as last resort\n\nBest contact chosen by: seniority (CEO > VP > Manager)\nUp to 5 backup contacts stored for rotation later","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"FIND THE BEST CONTACT — CHEAPEST SOURCES FIRST\n\nStep 1: Website scrape data (FREE)\n  Extract decision makers and their emails from crawled pages\nStep 2: Instagram profile (FREE)\n  Pull business email and phone from authenticated profile\nStep 3: Apollo pre-screen (FREE)\n  Check if Apollo has contact data — no credits charged\nStep 4: SMTP-verify every email found so far\n  MX lookup + mailbox probe + catch-all detection\n  Blocks ~500 known disposable email domains\n  Filters out generic addresses (info@, support@, sales@)\nStep 5: If still no valid email -> Hunter ($1 per lookup)\n  Domain search, discards results with confidence < 70%\nStep 6: If Hunter also fails -> Apollo ($1 per lookup)\n  Premium contact data used only as last resort\n\nBest contact chosen by: seniority (CEO > VP > Manager)\nUp to 5 backup contacts stored for rotation later","lineHeight":1.35},{"angle":0,"seed":174,"version":1,"versionNonce":175,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a5","x":225,"y":1150,"width":0,"height":230,"points":[[0,0],[0,230]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":176,"version":1,"versionNonce":177,"groupIds":[],"boundElements":[{"type":"text","id":"d1_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"diamond","id":"d1","x":170,"y":1380,"width":120,"height":80,"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#f59e0b","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":178,"version":1,"versionNonce":179,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"d1_label","x":170,"y":1380,"width":120,"height":80,"text":"Qualified?","fontSize":18,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":18,"containerId":"d1","originalText":"Qualified?","lineHeight":1.35},{"angle":0,"seed":180,"version":1,"versionNonce":181,"groupIds":[],"boundElements":[{"type":"text","id":"a5n_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a5n","x":290,"y":1420,