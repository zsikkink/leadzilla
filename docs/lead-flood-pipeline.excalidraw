lign":"top","baseline":24,"containerId":null,"originalText":"4. OUTREACH","lineHeight":1.35},{"angle":0,"seed":258,"version":1,"versionNonce":259,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"z4s","x":55,"y":2358,"width":556.8,"height":21.6,"text":"Generate personalized messages and manage the conversation","fontSize":16,"fontFamily":1,"strokeColor":"#15803d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"Generate personalized messages and manage the conversation","lineHeight":1.35},{"angle":0,"seed":260,"version":1,"versionNonce":261,"groupIds":[],"boundElements":[{"type":"text","id":"b9_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b9","x":100,"y":2400,"width":250,"height":55,"backgroundColor":"#b2f2bb","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#22c55e","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":262,"version":1,"versionNonce":263,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b9_label","x":100,"y":2400,"width":250,"height":55,"text":"Generate Message","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b9","originalText":"Generate Message","lineHeight":1.35},{"angle":0,"seed":264,"version":1,"versionNonce":265,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp9","x":420,"y":2395,"width":710,"height":230,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#b2f2bb","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":266,"version":1,"versionNonce":267,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt9","x":435,"y":2403,"width":614.4,"height":345.6,"text":"AI MESSAGE GENERATION (GPT-4)\n\nContext sent to AI (plain English, not raw numbers):\n  Company insight — tech stack, payment setup, pricing structure\n  Tech gaps — missing CRM, basic analytics, no live chat\n  Team signal — decision makers found on their website\n  Social presence — Instagram metrics and brand signals\n\nMessage framework: Acknowledge -> Compliment -> Ask\n  40-80 words (research-backed optimal length)\n  Single interest-gate CTA (never asks for a call)\n  Specific observation about THEIR business\n  Social proof: '47 UAE businesses like yours...'\n  Banned phrases auto-rejected and message retried\n\nFallback: Pre-written research-backed template if AI fails","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"AI MESSAGE GENERATION (GPT-4)\n\nContext sent to AI (plain English, not raw numbers):\n  Company insight — tech stack, payment setup, pricing structure\n  Tech gaps — missing CRM, basic analytics, no live chat\n  Team signal — decision makers found on their website\n  Social presence — Instagram metrics and brand signals\n\nMessage framework: Acknowledge -> Compliment -> Ask\n  40-80 words (research-backed optimal length)\n  Single interest-gate CTA (never asks for a call)\n  Specific observation about THEIR business\n  Social proof: '47 UAE businesses like yours...'\n  Banned phrases auto-rejected and message retried\n\nFallback: Pre-written research-backed template if AI fails","lineHeight":1.35},{"angle":0,"seed":268,"version":1,"versionNonce":269,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a9","x":225,"y":2455,"width":0,"height":180,"points":[[0,0],[0,180]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":270,"version":1,"versionNonce":271,"groupIds":[],"boundElements":[{"type":"text","id":"b10_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b10","x":100,"y":2635,"width":250,"height":55,"backgroundColor":"#b2f2bb","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#22c55e","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":272,"version":1,"versionNonce":273,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b10_label","x":100,"y":2635,"width":250,"height":55,"text":"Send Message","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b10","originalText":"Send Message","lineHeight":1.35},{"angle":0,"seed":274,"version":1,"versionNonce":275,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp10","x":420,"y":2630,"width":710,"height":135,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#b2f2bb","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":276,"version":1,"versionNonce":277,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt10","x":435,"y":2638,"width":614.4,"height":194.4,"text":"CHANNEL SELECTION AND RATE LIMITS\n\nHIGH score + has phone -> WhatsApp (via Trengo)\n  Template message for first contact, thread for follow-ups\n  Rate limit: 50 messages/day, UAE business hours only (9AM-6PM)\nMEDIUM score or no phone -> Email (via Resend)\n  Progressive warmup: 5/day, then +5/week, max 100/day\n  Auto-throttle: halves daily limit if bounce rate > 2%\n  Idempotency key prevents accidental duplicate sends","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"CHANNEL SELECTION AND RATE LIMITS\n\nHIGH score + has phone -> WhatsApp (via Trengo)\n  Template message for first contact, thread for follow-ups\n  Rate limit: 50 messages/day, UAE business hours only (9AM-6PM)\nMEDIUM score or no phone -> Email (via Resend)\n  Progressive warmup: 5/day, then +5/week, max 100/day\n  Auto-throttle: halves daily limit if bounce rate > 2%\n  Idempotency key prevents accidental duplicate sends","lineHeight":1.35},{"angle":0,"seed":278,"version":1,"versionNonce":279,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a10","x":225,"y":2690,"width":0,"height":90,"points":[[0,0],[0,90]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":280,"version":1,"versionNonce":281,"groupIds":[],"boundElements":[{"type":"text","id":"d3_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"diamond","id":"d3","x":170,"y":2780,"width":120,"height":80,"backgroundColor":"#fff3bf","fillStyle":"solid","strokeColor":"#22c55e","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":282,"version":1,"versionNonce":283,"groupIds":[],"boundElements":null,"isDeleted":false,"