okeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"Score every lead using 67 data points and machine learning","lineHeight":1.35},{"angle":0,"seed":198,"version":1,"versionNonce":199,"groupIds":[],"boundElements":[{"type":"text","id":"b7_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b7","x":100,"y":1610,"width":250,"height":55,"backgroundColor":"#d0bfff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#8b5cf6","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":200,"version":1,"versionNonce":201,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b7_label","x":100,"y":1610,"width":250,"height":55,"text":"Extract Features","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b7","originalText":"Extract Features","lineHeight":1.35},{"angle":0,"seed":202,"version":1,"versionNonce":203,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp7","x":420,"y":1600,"width":710,"height":210,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#d0bfff","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":204,"version":1,"versionNonce":205,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt7","x":435,"y":1608,"width":672,"height":302.40000000000003,"text":"67 FEATURES EXTRACTED ACROSS 6 CATEGORIES\n\nBusiness Model (8): has WhatsApp, Instagram, accepts online payments,\n  custom order signals, Shopify detected, multi-staff, etc.\nSocial and Engagement (6): review count + tier, follower count + tier,\n  follower growth signal, high engagement signal\nBusiness Complexity (8): recent activity, high ticket signals, deposit\n  and milestone signals, subscriptions, international customers\nWebsite Intelligence (8): decision maker count, email count, phone\n  count, social link count, has LinkedIn, tech stack size, has CRM\nInstagram Metrics (6): followers, engagement rate, business account,\n  days since last post, bio link, business category\nData Quality (1): data alignment score — cross-checks domain, brand,\n  geography, and contacts across all sources to verify consistency","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"67 FEATURES EXTRACTED ACROSS 6 CATEGORIES\n\nBusiness Model (8): has WhatsApp, Instagram, accepts online payments,\n  custom order signals, Shopify detected, multi-staff, etc.\nSocial and Engagement (6): review count + tier, follower count + tier,\n  follower growth signal, high engagement signal\nBusiness Complexity (8): recent activity, high ticket signals, deposit\n  and milestone signals, subscriptions, international customers\nWebsite Intelligence (8): decision maker count, email count, phone\n  count, social link count, has LinkedIn, tech stack size, has CRM\nInstagram Metrics (6): followers, engagement rate, business account,\n  days since last post, bio link, business category\nData Quality (1): data alignment score — cross-checks domain, brand,\n  geography, and contacts across all sources to verify consistency","lineHeight":1.35},{"angle":0,"seed":206,"version":1,"versionNonce":207,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a6","x":225,"y":1665,"width":0,"height":155,"points":[[0,0],[0,155]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":208,"version":1,"versionNonce":209,"groupIds":[],"boundElements":[{"type":"text","id":"b8_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b8","x":100,"y":1820,"width":250,"height":55,"backgroundColor":"#d0bfff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#8b5cf6","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":210,"version":1,"versionNonce":211,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b8_label","x":100,"y":1820,"width":250,"height":55,"text":"Score Lead","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b8","originalText":"Score Lead","lineHeight":1.35},{"angle":0,"seed":212,"version":1,"versionNonce":213,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp8","x":420,"y":1815,"width":710,"height":290,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#d0bfff","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":214,"version":1,"versionNonce":215,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt8","x":435,"y":1823,"width":672,"height":432,"text":"TWO SCORING SYSTEMS BLENDED TOGETHER\n\n1. DETERMINISTIC (Rule-Based)\n  Hard filters — if ANY fail, score = 0:\n    Industry must be supported | Country must match\n    Not pure self-serve ecommerce | Data alignment >= 0.3\n  Positive rules: 11 signals (WhatsApp, Instagram, payments,\n    reviews, followers, booking forms, etc.) — weight +18 each\n  Anti-fit penalties: 2 rules (pure self-serve, price-led) — weight -6\n  Category bonus: +10% if Sales Motion + Payment Complexity\n    both pass. -15% if fewer than 2 categories qualify.\n\n2. TRAINED ML MODEL (Logistic Regression)\n  47 features fed to model, trained on manually labeled leads\n  Class-weighted for data imbalance. Auto-retrains on 50+ new labels.\n\nBLEND RATIO (adapts to model quality):\n  No model yet         ->  90% rules / 10% ML\n  AUC >= 0.70, 200+ labels  ->  70% rules / 30% ML\n  AUC >= 0.80, 500+ labels  ->  50% rules / 50% ML","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"TWO SCORING SYSTEMS BLENDED TOGETHER\n\n1. DETERMINISTIC (Rule-Based)\n  Hard filters — if ANY fail, score = 0:\n    Industry must be supported | Country must match\n    Not pure self-serve ecommerce | Data alignment >= 0.3\n  Positive rules: 11 signals (WhatsApp, Instagram, payments,\n    reviews, followers, booking forms, etc.) — weight +18 each\n  Anti-fit penalties: 2 rules (pure self-serve, price-led) — weight -6\n  Category bonus: +10% if Sales Motion + Payment Complexity\n    both pass. -15% if fewer than 2 categories qualify.\n\n2. TRAINED ML MODEL (Logistic Regression)\n  47 features fed to model, trained on manually labeled leads\n  Class-weighted for data imbalance. Auto-retrains on 50+ new labels.\n\nBLEND RATIO (adapts to model quality):\n  No model yet         ->  90% rules / 10% ML\n  AUC >= 0.70, 200+ labels  ->  70% rules / 30% ML\n  AUC >= 0.80, 500+ labels  ->  50% rules / 50% ML","lineHeight":1.35},{"angle":0,"seed":216,"version":1,"versionNonce":217,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"