type":"arrow","id":"a11n","x":290,"y":2840,"width":100,"height":20,"points":[[0,0],[100,20]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#ef4444","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":292,"version":1,"versionNonce":293,"groupIds":[],"boundElements":[{"type":"text","id":"bno_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"bno","x":400,"y":2850,"width":160,"height":45,"backgroundColor":"#ffd8a8","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#f59e0b","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":294,"version":1,"versionNonce":295,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"bno_label","x":400,"y":2850,"width":160,"height":45,"text":"NO — Silence","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":16,"containerId":"bno","originalText":"NO — Silence","lineHeight":1.35},{"angle":0,"seed":296,"version":1,"versionNonce":297,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp_reply","x":580,"y":2770,"width":550,"height":140,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#b2f2bb","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":298,"version":1,"versionNonce":299,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt_reply","x":595,"y":2778,"width":614.4,"height":108,"text":"REPLY CLASSIFICATION (AI)\n  INTERESTED -> cancel follow-ups, notify sales team immediately\n  NOT INTERESTED -> mark lead cold, stop all outreach\n  UNSUBSCRIBE -> suppress ALL future contact permanently\n  OUT OF OFFICE -> pause follow-ups, reschedule +7 days","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"REPLY CLASSIFICATION (AI)\n  INTERESTED -> cancel follow-ups, notify sales team immediately\n  NOT INTERESTED -> mark lead cold, stop all outreach\n  UNSUBSCRIBE -> suppress ALL future contact permanently\n  OUT OF OFFICE -> pause follow-ups, reschedule +7 days","lineHeight":1.35},{"angle":0,"seed":300,"version":1,"versionNonce":301,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp_fu","x":580,"y":2920,"width":550,"height":120,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#ffd8a8","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":302,"version":1,"versionNonce":303,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt_fu","x":595,"y":2928,"width":681.6,"height":129.60000000000002,"text":"FOLLOW-UP CADENCE: 3-7-7\n  Message -> 3 days -> FU#1 -> 7 days -> FU#2 -> 7 days -> FU#3 -> stop\n  Each follow-up pitches a different product feature (rotated)\n  Random 1-3 hour jitter makes timing feel human\n  Follow-ups are auto-approved (no manual review needed)\n  Sales team emailed on every reply with full context","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"FOLLOW-UP CADENCE: 3-7-7\n  Message -> 3 days -> FU#1 -> 7 days -> FU#2 -> 7 days -> FU#3 -> stop\n  Each follow-up pitches a different product feature (rotated)\n  Random 1-3 hour jitter makes timing feel human\n  Follow-ups are auto-approved (no manual review needed)\n  Sales team emailed on every reply with full context","lineHeight":1.35},{"angle":0,"seed":304,"version":1,"versionNonce":305,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"c45","x":225,"y":2860,"width":0,"height":120,"points":[[0,0],[0,120]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#757575","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":306,"version":1,"versionNonce":307,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"z5bg","x":40,"y":3010,"width":1130,"height":660,"backgroundColor":"#c3fae8","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#06b6d4","strokeWidth":1,"roughness":1,"opacity":25},{"angle":0,"seed":308,"version":1,"versionNonce":309,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"z5t","x":55,"y":3018,"width":158.4,"height":32.400000000000006,"text":"5. LEARNING","fontSize":24,"fontFamily":1,"strokeColor":"#0d6e5e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":24,"containerId":null,"originalText":"5. LEARNING","lineHeight":1.35},{"angle":0,"seed":310,"version":1,"versionNonce":311,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"z5s","x":55,"y":3048,"width":547.1999999999999,"height":21.6,"text":"Analyze results, retrain the model, and improve over time","fontSize":16,"fontFamily":1,"strokeColor":"#0d6e5e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"Analyze results, retrain the model, and improve over time","lineHeight":1.35},{"angle":0,"seed":312,"version":1,"versionNonce":313,"groupIds":[],"boundElements":[{"type":"text","id":"b11_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b11","x":100,"y":3090,"width":250,"height":55,"backgroundColor":"#c3fae8","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#06b6d4","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":314,"version":1,"versionNonce":315,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b11_label","x":100,"y":3090,"width":250,"height":55,"text":"Analyze Results","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b11","originalText":"Analyze Results","lineHeight":1.35},{"angle":0,"seed":316,"version":1,"versionNonce":317,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp11","x":420,"y":3085,"width":710,"height":175,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#c3fae8","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":318,"version":1,"versionNonce":319,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt11","x":435,"y":3093,"width":643.1999999999999,"height":237.60000000000002,"text":"WEEKLY CAMPAIGN ANALYSIS\n\nPer-ICP breakdown: total sends, replies, positive outcomes, bounces\n  Bounce rate > 15% -> recommend pausing that ICP\n  Zero replies on 10+ sends -> recommend reviewing targeting\nPer-variant: which message versions get the best reply rates\n  A/B comparison using chi-squared significance test\n  Only recommends changes when p < 0.05 (statistically significant)\nScore band check: if MEDIUM-scored leads outperform HIGH,\n  the scoring threshold may need adjustment\nWeek-over-week trend detection for declining performance","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"WEEKLY CAMPAIGN ANALYSIS\n\nPer-ICP breakdown: total sends, replies, positive outcomes, bounces\n  Bounce rate > 15% -> recommend pausing that ICP\n  Zero replies on 10+ sends -> recommend reviewing targeting\nPer-variant: which message versions get the best reply rates\n  A/B comparison using chi-squared significance test\n  Only recommends changes when p < 0.05 (statistically significant)\nScore band check: if MEDIUM-scored leads outperform HIGH,\n  the scoring threshold may need adjustment\nWeek-over-week trend detection for declining performance","lineHeight":1.35},{"angle":0,"seed":320,"version":1,"versionNonce":321,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a12","x":225,"y":3145,"width":0,"height":130,"points":[[0,0],[0,130]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":322,"version":1,"versionNonce":323,"groupIds":[],"boundElements":[{"type":"text","id":"b12_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b12","x":100,"y":3275,"width":250,"height":55,"backgroundColor":"#c3fae8","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#06b6d4","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":324,"version":1,"versionNonce":325,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b12_label","x":100,"y":3275,"width":250,"height":55,"text":"Generate Labels","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b12","originalText":"Generate Labels","lineHeight":1.35},{"angle":0,"seed":326,"version":1,"versionNonce":327,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp12","x":420,"y":3270,"width":710,"height":130,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#c3fae8","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":328,"version":1,"versionNonce":329,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt12","x":435,"y":3278,"width":614.4,"height":172.8,"text":"TRAINING LABELS FROM REAL OUTCOMES\n\nPositive labels (good lead = 1): meeting booked, deal won\nNegative labels (bad lead = 0): deal lost, unsubscribed\nCold timeout (bad lead = 0): message sent 30+ days ago, no reply\n\nLabels generated continuously as feedback arrives.\nWhen 50+ new labels accumulate, auto-triggers model retraining.","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"TRAINING LABELS FROM REAL OUTCOMES\n\nPositive labels (good lead = 1): meeting booked, deal won\nNegative labels (bad lead = 0): deal lost, unsubscribed\nCold timeout (bad lead = 0): message sent 30+ days ago, no reply\n\nLabels generated continuously as feedback arrives.\nWhen 50+ new labels accumulate, auto-triggers model retraining.","lineHeight":1.35},{"angle":0,"seed":330,"version":1,"versionNonce":331,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"a13","x":225,"y":3330,"width":0,"height":80,"points":[[0,0],[0,80]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#1e1e1e","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":332,"version":1,"versionNonce":333,"groupIds":[],"boundElements":[{"type":"text","id":"b13_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"b13","x":100,"y":3410,"width":250,"height":55,"backgroundColor":"#c3fae8","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#06b6d4","strokeWidth":2,"roughness":1,"opacity":100},{"angle":0,"seed":334,"version":1,"versionNonce":335,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"b13_label","x":100,"y":3410,"width":250,"height":55,"text":"Retrain Model","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":20,"containerId":"b13","originalText":"Retrain Model","lineHeight":1.35},{"angle":0,"seed":336,"version":1,"versionNonce":337,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"rectangle","id":"dp13","x":420,"y":3405,"width":710,"height":195,"backgroundColor":"#ffffff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#c3fae8","strokeWidth":1,"roughness":1,"opacity":85},{"angle":0,"seed":338,"version":1,"versionNonce":339,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"dt13","x":435,"y":3413,"width":624,"height":302.40000000000003,"text":"AUTOMATIC MODEL RETRAINING\n\nAlgorithm: Logistic regression on 47 selected features\nDataset split: 60% train / 20% validate / 20% test\nClass weights automatically balance positive vs negative examples\n\nNew model starts in SHADOW mode (not scoring real leads yet).\nPromoted to ACTIVE only after evaluation metrics pass:\n  AUC >= 0.70 on test set = minimum activation threshold\n  Higher AUC = more weight given to ML in the blend\n\nThe retrained model feeds directly back into the scoring step\n(Zone 3), creating a continuous improvement loop that gets\nsmarter with every deal won and every reply received.","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"left","verticalAlign":"top","baseline":16,"containerId":null,"originalText":"AUTOMATIC MODEL RETRAINING\n\nAlgorithm: Logistic regression on 47 selected features\nDataset split: 60% train / 20% validate / 20% test\nClass weights automatically balance positive vs negative examples\n\nNew model starts in SHADOW mode (not scoring real leads yet).\nPromoted to ACTIVE only after evaluation metrics pass:\n  AUC >= 0.70 on test set = minimum activation threshold\n  Higher AUC = more weight given to ML in the blend\n\nThe retrained model feeds directly back into the scoring step\n(Zone 3), creating a continuous improvement loop that gets\nsmarter with every deal won and every reply received.","lineHeight":1.35},{"angle":0,"seed":340,"version":1,"versionNonce":341,"groupIds":[],"boundElements":[{"type":"text","id":"loop_label"}],"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"arrow","id":"loop","x":350,"y":3437,"width":150,"height":-1582,"points":[[0,0],[150,0],[150,-1582],[0,-1582]],"endArrowhead":"arrow","startArrowhead":null,"strokeColor":"#06b6d4","strokeWidth":2,"strokeStyle":"dashed","roughness":1,"opacity":100,"fillStyle":"solid","backgroundColor":"transparent","startBinding":null,"endBinding":null,"lastCommittedPoint":null},{"angle":0,"seed":342,"version":1,"versionNonce":343,"groupIds":[],"boundElements":null,"isDeleted":false,"updated":1772763286540,"link":null,"locked":false,"type":"text","id":"loop_label","x":405,"y":2636,"width":80,"height":20,"text":"retrain loop","fontSize":16,"fontFamily":1,"strokeColor":"#06b6d4","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":1,"opacity":100,"textAlign":"center","verticalAlign":"middle","baseline":16,"containerId":"loop","originalText":"retrain loop","lineHeight":1.35}],"appState":{"gridSize":null,"viewBackgroundColor":"#ffffff"},"files":{}}