{
  "name": "@lead-flood/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./runtime-database-url-policy": {
      "types": "./dist/src/runtime-database-url-policy.d.ts",
      "default": "./dist/src/runtime-database-url-policy.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "dev": "tsc -w -p tsconfig.json",
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "lint": "eslint src prisma --ext .ts",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'src/discovery-phase1-*.test.ts'",
    "test:unit": "vitest run",
    "test:sql:discovery-phase1": "bash ../../scripts/db/test-discovery-phase1-sql.sh",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "bash ../../scripts/db/guard-no-prisma-migrate-prod.sh \"prisma migrate deploy\" && prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "prisma generate --schema prisma/schema.prisma && node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@lead-flood/contracts": "workspace:*",
    "@prisma/client": "^6.2.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2"
  }
}
