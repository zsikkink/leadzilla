generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  new
  processing
  enriched
  scored
  qualified
  drafted
  rejected
  stuck
  failed
  messaged
  replied
  cold
}

enum ContactRecoveryStatus {
  OPEN
  APPROVED
  REJECTED
}

enum ContactRecoveryReason {
  NO_CONTACTS_FOUND
  NO_EMAIL
  DECISION_MAKER_IDENTIFIED
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum OutboxStatus {
  pending
  processing
  sent
  failed
  dead_letter
}

enum QualificationRuleType {
  WEIGHTED
  HARD_FILTER
}

enum QualificationLogic {
  WEIGHTED
}

enum QualificationOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  IN
  NOT_IN
  CONTAINS
}

enum DiscoveryProvider {
  BRAVE_SEARCH
  GOOGLE_PLACES
  GOOGLE_SEARCH
  LINKEDIN_SCRAPE
  COMPANY_SEARCH_FREE
  APOLLO
  SERPAPI
}

enum CostEventProvider {
  SERPAPI
  APOLLO
  APIFY_WEBSITE
  APIFY_INSTAGRAM
  HUNTER
  GOOGLE_PLACES
  GOOGLE_CUSTOM_SEARCH
}

enum DiscoveryRecordStatus {
  DISCOVERED
  DUPLICATE
  REJECTED
  ERROR
}

enum EnrichmentProvider {
  HUNTER
  CLEARBIT
  OTHER_FREE
  PEOPLE_DATA_LABS
  APOLLO
}

enum EnrichmentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ApolloRevealAttemptStatus {
  CLAIMED
  COMPLETED
  ABANDONED
}

enum TrainingRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum TrainingTrigger {
  MANUAL
  SCHEDULED
  FEEDBACK_THRESHOLD
}

enum ModelType {
  LOGISTIC_REGRESSION
}

enum ModelStage {
  SHADOW
  ACTIVE
  ARCHIVED
}

enum EvaluationSplit {
  TRAIN
  VALIDATION
  TEST
}

enum ScoreBand {
  LOW
  MEDIUM
  HIGH
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum MessageSendStatus {
  QUEUED
  SENDING
  UNRESOLVED
  SENT
  DELIVERED
  REPLIED
  BOUNCED
  FAILED
}

enum SendProvider {
  RESEND
  TRENGO
}

enum FeedbackEventType {
  REPLIED
  MEETING_BOOKED
  DEAL_WON
  DEAL_LOST
  UNSUBSCRIBED
  BOUNCED
  NOT_INTERESTED
}

enum FeedbackSource {
  WEBHOOK
  MANUAL
  CRM_IMPORT
}

enum LabelSource {
  FEEDBACK_EVENT
  COLD_LEAD_TIMEOUT
  MANUAL
}

enum ReplyClassification {
  INTERESTED
  NOT_INTERESTED
  OUT_OF_OFFICE
  UNSUBSCRIBE
}

enum SearchTaskType {
  SERP_GOOGLE
  SERP_GOOGLE_LOCAL
  SERP_MAPS_LOCAL
}

enum SearchTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum DiscoverySourceType {
  DIRECTORY
  SMB_SITE
  SOCIAL
  MARKETPLACE
  UNKNOWN
}

enum JobRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

model Lead {
  id                  String        @id @default(cuid())
  firstName           String
  lastName            String
  email               String        @unique
  phone               String?
  phoneSource         String?
  businessEmail       String?
  source              String
  status              LeadStatus    @default(new)
  enrichmentData      Json?
  error               String?
  costCents           Int           @default(0)
  deletedAt           DateTime?
  businessId          String?
  business            Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  decisionMakerTitle  String?
  decisionMakerPhone  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  jobs                JobExecution[]
  discoveryRecords    LeadDiscoveryRecord[]
  enrichmentRecords   LeadEnrichmentRecord[]
  featureSnapshots    LeadFeatureSnapshot[]
  scorePredictions    LeadScorePrediction[]
  messageDrafts       MessageDraft[]
  messageSends        MessageSend[]
  feedbackEvents      FeedbackEvent[]
  trainingLabels      TrainingLabel[]
  businessConversions BusinessConversion[]
  pipelineEvents      LeadPipelineEvent[]
  apolloRevealAttempts ApolloRevealAttempt[]
  rejection           LeadRejection?

  @@index([status])
  @@index([source])
  @@index([phone])
  @@index([deletedAt])
  @@index([deletedAt, createdAt], map: "Lead_deletedAt_createdAt_idx")
  @@index([businessId])
}

model JobExecution {
  id         String    @id @default(cuid())
  type       String
  status     JobStatus @default(queued)
  attempts   Int       @default(0)
  payload    Json
  result     Json?
  error      String?
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([type])
  @@index([type, createdAt], map: "JobExecution_type_createdAt_idx")
  @@index([status])
  @@index([leadId])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  type          String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([nextAttemptAt])
}

model IcpProfile {
  id                   String               @id @default(cuid())
  name                 String
  description          String?
  qualificationLogic   QualificationLogic   @default(WEIGHTED)
  metadataJson         Json?
  targetIndustries     String[]             @default([])
  targetCountries      String[]             @default([])
  minCompanySize       Int?
  maxCompanySize       Int?
  requiredTechnologies String[]             @default([])
  excludedDomains      String[]             @default([])
  featureList          Json?
  isActive             Boolean              @default(true)
  /// Supabase Auth user id (auth.users.id). The SQL schema intentionally does
  /// not enforce a legacy public.User foreign key.
  createdByUserId      String?
  qualificationRules   QualificationRule[]
  discoveryRecords     LeadDiscoveryRecord[]
  featureSnapshots     LeadFeatureSnapshot[]
  scorePredictions     LeadScorePrediction[]
  apolloRevealAttempts ApolloRevealAttempt[]
  analyticsDailyRollups AnalyticsDailyRollup[]
  messageDrafts        MessageDraft[]
  contactRecoveryItems ContactRecoveryItem[]
  discoveryAttributionAssignments DiscoveryAttributionAssignment[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([name])
  @@index([isActive])
}

model QualificationRule {
  id           String                @id @default(cuid())
  icpProfileId String
  icpProfile   IcpProfile            @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  name         String
  ruleType     QualificationRuleType
  isRequired   Boolean               @default(false)
  fieldKey     String
  operator     QualificationOperator
  valueJson    Json
  weight       Float?
  orderIndex   Int                   @default(100)
  isActive     Boolean               @default(true)
  priority     Int                   @default(100)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([icpProfileId, isActive, orderIndex])
  @@index([icpProfileId, isActive, priority])
}

model LeadDiscoveryRecord {
  id               String              @id @default(cuid())
  leadId           String
  lead             Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icpProfileId     String
  icpProfile       IcpProfile          @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  provider         DiscoveryProvider
  providerSource   String?
  providerConfidence Float?
  providerRecordId String
  providerCursor   String?
  queryHash        String
  status           DiscoveryRecordStatus @default(DISCOVERED)
  rawPayload       Json
  provenanceJson   Json?
  errorMessage     String?
  discoveredAt     DateTime            @default(now())
  createdAt        DateTime            @default(now())

  featureSnapshots LeadFeatureSnapshot[]

  @@unique([leadId, icpProfileId, provider, providerRecordId])
  @@index([leadId, discoveredAt])
  @@index([icpProfileId, discoveredAt])
  @@index([provider, providerSource])
  @@index([provider, status])
}

model LeadEnrichmentRecord {
  id                String            @id @default(cuid())
  leadId            String
  lead              Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  provider          EnrichmentProvider
  status            EnrichmentStatus  @default(PENDING)
  attempt           Int               @default(1)
  providerRecordId  String?
  normalizedPayload Json?
  rawPayload        Json?
  errorCode         String?
  errorMessage      String?
  enrichedAt        DateTime?
  requestKey        String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  featureSnapshots  LeadFeatureSnapshot[]

  @@index([leadId, provider, createdAt])
  @@index([leadId, provider, status])
  @@index([leadId, enrichedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "LeadEnrichmentRecord_leadId_enrichedAt_createdAt_id_idx")
}

model LeadFeatureSnapshot {
  id                String              @id @default(cuid())
  leadId            String
  lead              Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icpProfileId      String
  icpProfile        IcpProfile          @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  discoveryRecordId String?
  discoveryRecord   LeadDiscoveryRecord? @relation(fields: [discoveryRecordId], references: [id], onDelete: SetNull)
  enrichmentRecordId String?
  enrichmentRecord  LeadEnrichmentRecord? @relation(fields: [enrichmentRecordId], references: [id], onDelete: SetNull)
  snapshotVersion   Int
  sourceVersion     String
  featureVectorHash String
  featuresJson      Json
  ruleMatchCount    Int                 @default(0)
  hardFilterPassed  Boolean             @default(false)
  computedAt        DateTime            @default(now())
  createdAt         DateTime            @default(now())

  scorePredictions  LeadScorePrediction[]

  @@unique([leadId, icpProfileId, snapshotVersion, sourceVersion, featureVectorHash])
  @@index([leadId, icpProfileId, computedAt])
  @@index([featureVectorHash])
}

model TrainingRun {
  id                 String            @id @default(cuid())
  modelType          ModelType         @default(LOGISTIC_REGRESSION)
  status             TrainingRunStatus @default(QUEUED)
  trigger            TrainingTrigger
  /// Supabase Auth user id (auth.users.id). The SQL schema intentionally does
  /// not enforce a legacy public.User foreign key.
  triggeredByUserId  String?
  configJson         Json
  trainingWindowStart DateTime
  trainingWindowEnd  DateTime
  datasetSize        Int               @default(0)
  positiveCount      Int               @default(0)
  negativeCount      Int               @default(0)
  startedAt          DateTime?
  endedAt            DateTime?
  errorMessage       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  modelVersions      ModelVersion[]
  evaluations        ModelEvaluation[]

  @@index([status, createdAt])
}

/// The canonical SQL migration chain enforces at most one ACTIVE row per
/// modelType via a partial unique index that Prisma cannot express here.
model ModelVersion {
  id                     String              @id @default(cuid())
  trainingRunId          String
  trainingRun            TrainingRun         @relation(fields: [trainingRunId], references: [id], onDelete: Cascade)
  modelType              ModelType           @default(LOGISTIC_REGRESSION)
  versionTag             String              @unique
  stage                  ModelStage          @default(SHADOW)
  featureSchemaJson      Json
  coefficientsJson       Json?
  intercept              Float?
  deterministicWeightsJson Json
  artifactUri            String?
  checksum               String
  trainedAt              DateTime            @default(now())
  activatedAt            DateTime?
  retiredAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  evaluations            ModelEvaluation[]
  scorePredictions       LeadScorePrediction[]

  @@index([modelType, stage])
}

model ModelEvaluation {
  id                  String          @id @default(cuid())
  modelVersionId      String
  modelVersion        ModelVersion    @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  trainingRunId       String
  trainingRun         TrainingRun     @relation(fields: [trainingRunId], references: [id], onDelete: Cascade)
  split               EvaluationSplit
  sampleSize          Int
  positiveRate        Float
  auc                 Float
  prAuc               Float
  precision           Float
  recall              Float
  f1                  Float
  brierScore          Float
  calibrationJson     Json?
  confusionMatrixJson Json?
  evaluatedAt         DateTime        @default(now())
  createdAt           DateTime        @default(now())

  @@index([modelVersionId, split])
  @@index([trainingRunId, split])
}

model LeadScorePrediction {
  id                String             @id @default(cuid())
  leadId            String
  lead              Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icpProfileId      String
  icpProfile        IcpProfile         @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  featureSnapshotId String
  featureSnapshot   LeadFeatureSnapshot @relation(fields: [featureSnapshotId], references: [id], onDelete: Cascade)
  modelVersionId    String
  modelVersion      ModelVersion       @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  deterministicScore Float
  logisticScore     Float
  blendedScore      Float
  scoreBand         ScoreBand
  reasonsJson       Json
  ruleEvaluationJson Json?
  predictedAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())

  apolloRevealAttempts ApolloRevealAttempt[]
  messageDrafts     MessageDraft[]

  @@unique([leadId, icpProfileId, featureSnapshotId, modelVersionId])
  @@index([leadId, predictedAt])
  @@index([leadId, icpProfileId, predictedAt], map: "LeadScorePrediction_leadId_icpProfileId_predictedAt_idx")
  @@index([icpProfileId, predictedAt])
  @@index([modelVersionId, predictedAt])
  @@index([predictedAt, id], map: "LeadScorePrediction_predictedAt_id_read_idx")
}

model ApolloRevealAttempt {
  id               String                    @id @default(cuid())
  leadId           String
  lead             Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icpProfileId     String
  icpProfile       IcpProfile                @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  scorePredictionId String
  scorePrediction  LeadScorePrediction       @relation(fields: [scorePredictionId], references: [id], onDelete: Cascade)
  discoveryRunId   String?
  status           ApolloRevealAttemptStatus @default(CLAIMED)
  jobId            String?
  claimedAt        DateTime                  @default(now())
  completedAt      DateTime?
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([leadId, icpProfileId, scorePredictionId])
  @@index([status])
}

model AnalyticsDailyRollup {
  id                String      @id @default(cuid())
  day               DateTime
  icpProfileId      String
  icpProfile        IcpProfile  @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  discoveredCount   Int         @default(0)
  qualifiedCount    Int         @default(0)
  enrichedCount     Int         @default(0)
  scoredCount       Int         @default(0)
  scoreSum          Float       @default(0)
  lowScoreCount     Int         @default(0)
  mediumScoreCount  Int         @default(0)
  highScoreCount    Int         @default(0)
  scoreBucket0Count Int         @default(0)
  scoreBucket1Count Int         @default(0)
  scoreBucket2Count Int         @default(0)
  scoreBucket3Count Int         @default(0)
  scoreBucket4Count Int         @default(0)
  scoreBucket5Count Int         @default(0)
  scoreBucket6Count Int         @default(0)
  scoreBucket7Count Int         @default(0)
  scoreBucket8Count Int         @default(0)
  scoreBucket9Count Int         @default(0)
  validEmailCount   Int         @default(0)
  validDomainCount  Int         @default(0)
  industryMatchRate Float       @default(0)
  geoMatchRate      Float       @default(0)
  messagesGeneratedCount Int    @default(0)
  sentCount         Int         @default(0)
  failedCount       Int         @default(0)
  repliedCount      Int         @default(0)
  meetingsCount     Int         @default(0)
  dealsWonCount     Int         @default(0)
  dealLostCount     Int         @default(0)
  bouncedCount      Int         @default(0)
  notInterestedCount Int        @default(0)
  rejectedCount     Int         @default(0)
  totalCostCents    Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([day, icpProfileId])
  @@index([day])
  @@index([icpProfileId, day])
}

model MessageDraft {
  id                   String                @id @default(cuid())
  leadId               String
  lead                 Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icpProfileId         String
  icpProfile           IcpProfile            @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  scorePredictionId    String?
  scorePrediction      LeadScorePrediction?  @relation(fields: [scorePredictionId], references: [id], onDelete: SetNull)
  promptVersion        String
  generatedByModel     String
  groundingKnowledgeIds String[]             @default([])
  groundingContextJson Json?
  approvalStatus       MessageApprovalStatus @default(PENDING)
  approvedByUserId     String?
  approvedAt           DateTime?
  rejectedReason       String?
  followUpNumber       Int                   @default(0)
  pitchedFeature       String?
  parentMessageSendId  String?
  parentMessageSend    MessageSend?          @relation("followUpChain", fields: [parentMessageSendId], references: [id], onDelete: SetNull)
  variants             MessageVariant[]
  messageSends         MessageSend[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([leadId, createdAt])
  @@index([icpProfileId, createdAt])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt], map: "MessageDraft_approvalStatus_createdAt_idx")
  @@index([leadId, approvalStatus])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "MessageDraft_createdAt_id_idx")
}

model MessageVariant {
  id             String         @id @default(cuid())
  messageDraftId String
  messageDraft   MessageDraft   @relation(fields: [messageDraftId], references: [id], onDelete: Cascade)
  variantKey     String
  channel        MessageChannel @default(EMAIL)
  subject        String?
  bodyText       String
  bodyHtml       String?
  ctaText        String?
  qualityScore   Float?
  isSelected     Boolean        @default(false)
  messageSends   MessageSend[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([messageDraftId])
}

model MessageSend {
  id                      String            @id @default(cuid())
  leadId                  String
  lead                    Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageDraftId          String
  messageDraft            MessageDraft      @relation(fields: [messageDraftId], references: [id], onDelete: Cascade)
  messageVariantId        String
  messageVariant          MessageVariant    @relation(fields: [messageVariantId], references: [id], onDelete: Restrict)
  channel                 MessageChannel    @default(EMAIL)
  provider                SendProvider      @default(RESEND)
  providerMessageId       String?
  providerConversationId  String?
  status                  MessageSendStatus @default(QUEUED)
  idempotencyKey          String            @unique
  scheduledAt             DateTime?
  sentAt                  DateTime?
  deliveredAt             DateTime?
  repliedAt               DateTime?
  followUpNumber          Int               @default(0)
  nextFollowUpAfter       DateTime?
  failureCode             String?
  failureReason           String?
  feedbackEvents          FeedbackEvent[]
  followUpDrafts          MessageDraft[]    @relation("followUpChain")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([leadId, createdAt])
  @@index([status])
  @@index([messageDraftId])
  @@index([providerConversationId])
  @@index([status, followUpNumber, nextFollowUpAfter])
  @@index([sentAt, status])
  @@index([leadId, status])
}

model FeedbackEvent {
  id              String            @id @default(cuid())
  leadId          String
  lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageSendId   String?
  messageSend     MessageSend?      @relation(fields: [messageSendId], references: [id], onDelete: SetNull)
  eventType       FeedbackEventType
  source          FeedbackSource
  providerEventId String?
  dedupeKey       String            @unique
  payloadJson     Json?
  replyText           String?
  replyClassification ReplyClassification?
  occurredAt      DateTime
  createdAt       DateTime          @default(now())

  trainingLabels  TrainingLabel[]

  @@index([leadId, occurredAt])
  @@index([messageSendId])
  @@index([eventType])
  @@index([leadId, eventType])
  @@index([createdAt])
  @@index([eventType, occurredAt])
  @@index([messageSendId, eventType, occurredAt])
}

model TrainingLabel {
  id              String         @id @default(cuid())
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  feedbackEventId String?
  feedbackEvent   FeedbackEvent? @relation(fields: [feedbackEventId], references: [id], onDelete: SetNull)
  label           Int
  source          LabelSource
  createdAt       DateTime       @default(now())

  @@unique([leadId, feedbackEventId])
  @@index([createdAt])
  @@index([label])
  @@index([leadId])
}

model SearchTask {
  id                 String           @id @default(uuid())
  taskType           SearchTaskType   @map("task_type")
  countryCode        String           @map("country_code")
  city               String?
  language           String
  queryText          String           @map("query_text")
  normalizedQueryKey String           @map("normalized_query_key")
  queryHash          String           @map("query_hash")
  paramsJson         Json             @map("params_json")
  page               Int
  timeBucket         String           @map("time_bucket")
  status             SearchTaskStatus @default(PENDING)
  attempts           Int              @default(0)
  runAfter           DateTime         @default(now()) @map("run_after")
  lastResultHash     String?          @map("last_result_hash")
  error              String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  discoveryRunId     String?          @map("discovery_run_id")

  discoveredSources  Source[]
  businessEvidence   BusinessEvidence[]
  discoveryAttributionAssignments DiscoveryAttributionAssignment[]

  @@unique([taskType, queryHash, discoveryRunId])
  @@index([status, runAfter])
  @@index([countryCode, language, timeBucket])
  @@index([discoveryRunId])
  @@map("search_tasks")
}

model Source {
  id                   String      @id @default(uuid())
  type                 DiscoverySourceType
  rootDomain           String      @map("root_domain")
  url                  String      @unique
  countryHint          String?     @map("country_hint")
  discoveredFromTaskId String?     @map("discovered_from_task_id")
  discoveredFromTask   SearchTask? @relation(fields: [discoveredFromTaskId], references: [id], onDelete: SetNull)
  score                Float       @default(0)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@index([rootDomain])
  @@index([countryHint])
  @@map("sources")
}

model Business {
  id                       String              @id @default(uuid())
  name                     String
  countryCode              String              @map("country_code")
  country                  String?
  city                     String?
  address                  String?
  phoneE164                String?             @map("phone_e164")
  websiteDomain            String?             @map("website_domain")
  instagramHandle          String?             @map("instagram_handle")
  category                 String?
  rating                   Float?
  reviewCount              Int?                @map("review_count")
  deterministicScore       Float               @default(0) @map("deterministic_score")
  scoreBand                ScoreBand?          @map("score_band")
  hasWhatsapp              Boolean             @default(false) @map("has_whatsapp")
  hasInstagram             Boolean             @default(false) @map("has_instagram")
  acceptsOnlinePayments    Boolean             @default(false) @map("accepts_online_payments")
  followerCount            Int?                @map("follower_count")
  physicalAddressPresent   Boolean             @default(false) @map("physical_address_present")
  recentActivity           Boolean             @default(false) @map("recent_activity")
  lat                      Float?
  lng                      Float?
  confidence               Float               @default(0.5)
  apifyWebsiteScrapeJson   Json?               @map("apify_website_scrape_json")
  apifyInstagramScrapeJson Json?               @map("apify_instagram_scrape_json")
  websiteScrapedAt         DateTime?           @map("website_scraped_at")
  instagramScrapedAt       DateTime?           @map("instagram_scraped_at")
  discoveryRunId           String?             @map("discovery_run_id")
  preQualified             Boolean?            @map("pre_qualified")
  disqualificationReason   String?             @map("disqualification_reason")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  evidence                 BusinessEvidence[]
  leads                    Lead[]
  businessConversions      BusinessConversion[]
  costEvents               DiscoveryCostEvent[]
  contacts                 BusinessContact[]    @relation("businessContacts")
  contactRecoveryItems     ContactRecoveryItem[]
  discoveryAttributionAssignments DiscoveryAttributionAssignment[]

  @@index([countryCode, city])
  @@index([websiteDomain])
  @@index([phoneE164])
  @@index([discoveryRunId])
  @@index([discoveryRunId, deterministicScore], map: "businesses_discovery_run_id_deterministic_score_idx")
  @@index([preQualified])
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "businesses_created_at_id_idx")
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "businesses_updated_at_id_idx")
  @@map("businesses")
}

model ContactRecoveryItem {
  id               String                @id @default(cuid())
  businessId       String                @map("business_id")
  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  icpProfileId     String                @map("icp_profile_id")
  icpProfile       IcpProfile            @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  discoveryRunId   String                @map("discovery_run_id")
  status           ContactRecoveryStatus @default(OPEN)
  reason           ContactRecoveryReason
  evidenceScore    Float                 @default(0) @map("evidence_score")
  candidateCount   Int                   @default(0) @map("candidate_count")
  recoverySnapshot Json                  @map("recovery_snapshot")
  rejectedBy       String?               @map("rejected_by")
  rejectedAt       DateTime?             @map("rejected_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@unique([businessId, icpProfileId])
  @@index([status, updatedAt])
  @@index([reason])
  @@index([discoveryRunId])
  @@index([icpProfileId, status])
  @@map("contact_recovery_items")
}

model DiscoveryAttributionAssignment {
  id             String     @id @default(uuid())
  discoveryRunId String     @map("discovery_run_id")
  icpProfileId   String     @map("icp_profile_id")
  icpProfile     IcpProfile @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  businessId     String     @map("business_id")
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  searchTaskId   String     @map("search_task_id")
  searchTask     SearchTask @relation(fields: [searchTaskId], references: [id], onDelete: Cascade)
  assignmentMode String     @map("assignment_mode")
  assignedAt     DateTime   @default(now()) @map("assigned_at")
  primaryOutcomeCode String?   @map("primary_outcome_code")
  primaryOutcomeAt   DateTime? @map("primary_outcome_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@unique([discoveryRunId, icpProfileId, businessId])
  @@index([searchTaskId])
  @@map("discovery_attribution_assignments")
}

model BusinessEvidence {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  searchTaskId   String?  @map("search_task_id")
  searchTask     SearchTask? @relation(fields: [searchTaskId], references: [id], onDelete: SetNull)
  sourceUrl      String   @map("source_url")
  sourceType     String   @map("source_type")
  serpapiResultId String? @map("serpapi_result_id")
  rawJson        Json     @map("raw_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([businessId])
  @@index([searchTaskId])
  @@map("business_evidence")
}

model ManagerAnalysis {
  id                     String   @id @default(cuid())
  runId                  String   @unique
  weekStart              DateTime
  weekEnd                DateTime
  totalSends             Int      @default(0)
  totalReplies           Int      @default(0)
  totalPositive          Int      @default(0)
  totalBounced           Int      @default(0)
  overallReplyRate       Float    @default(0)
  overallPositiveRate    Float    @default(0)
  overallBounceRate      Float    @default(0)
  icpBreakdownJson       Json
  variantBreakdownJson   Json
  scoreBandBreakdownJson Json
  trendJson              Json
  recommendationsJson    Json
  abInsightsPerIcpJson   Json?
  recommendationCount    Int      @default(0)
  createdAt              DateTime @default(now())

  storedRecommendations  ManagerRecommendationRecord[]

  @@index([weekStart])
  @@index([createdAt])
}

model JobRun {
  id          String       @id @default(uuid())
  jobName     String       @map("job_name")
  startedAt   DateTime     @default(now()) @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  durationMs  Int?         @map("duration_ms")
  status      JobRunStatus
  paramsJson  Json         @map("params_json")
  countersJson Json?       @map("counters_json")
  resourceJson Json?       @map("resource_json")
  errorText   String?      @map("error_text")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("job_runs")
}

model DiscoveryCostEvent {
  id             String            @id @default(cuid())
  discoveryRunId String
  provider       CostEventProvider
  costCents      Int
  apiCallType    String
  businessId     String?
  business       Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  leadId         String?
  recordedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())

  @@index([discoveryRunId])
  @@index([provider])
  @@index([businessId])
  @@map("discovery_cost_events")
}

model BusinessConversion {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icpProfileId       String?
  apolloContactJson  Json?
  hunterContactJson  Json?
  metadata              Json?
  businessInsights      String?
  apolloHasEmail        Boolean?   @map("apollo_has_email")
  apolloHasDirectPhone  Boolean?   @map("apollo_has_direct_phone")
  convertedAt           DateTime @default(now())
  createdAt             DateTime @default(now())

  @@unique([businessId, leadId])
  @@index([businessId])
  @@index([leadId])
  @@map("business_conversions")
}

model PipelineSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("pipeline_settings")
}

model LeadPipelineEvent {
  id         String   @id @default(cuid())
  leadId     String   @map("lead_id")
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage      String
  status     String
  jobId      String?  @map("job_id")
  durationMs Int?     @map("duration_ms")
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([leadId, occurredAt])
  @@index([stage, status])
  @@index([jobId])
  @@map("lead_pipeline_events")
}

model BusinessContact {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation("businessContacts", fields: [businessId], references: [id])
  name         String
  title        String?
  email        String?
  phone        String?
  linkedinUrl  String?
  seniority    String   @default("other")
  positionRank Int      @default(99)
  source       String   @default("website_scrape")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@map("business_contacts")
}

model LeadRejection {
  id           String   @id @default(cuid())
  leadId       String   @unique
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  businessId   String?
  domain       String?
  icpProfileId String?
  score        Float?
  reason       String
  rejectedBy   String
  rejectedAt   DateTime @default(now())
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([icpProfileId])
  @@index([reason])
  @@map("lead_rejections")
}

model ManagerRecommendationRecord {
  id               String   @id @default(cuid())
  type             String
  title            String
  description      String   @db.Text
  icpProfileId     String?
  icpName          String?
  field            String?
  currentValue     Float?
  recommendedValue Float?
  confidence       Float    @default(0)
  priority         Int      @default(5)
  status           String   @default("active")
  analysisRunId    String?

  analysis         ManagerAnalysis? @relation(fields: [analysisRunId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([icpProfileId, status])
  @@index([analysisRunId])
  @@map("manager_recommendation_records")
}

model PublicDemoDiscoveryAdmission {
  sessionHash    String   @map("session_hash")
  idempotencyKey String   @db.Uuid @map("idempotency_key")
  runId          String   @unique @map("run_id")
  taskBudget     Int      @map("task_budget")
  state          String   @default("reserved")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")
  expiresAt      DateTime @db.Timestamptz(6) @map("expires_at")

  @@id([sessionHash, idempotencyKey])
  @@map("public_demo_discovery_admissions")
}
